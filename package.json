{
  "name": "@mobius-os/desktop",
  "productName": "Möbius Desktop",
  "version": "0.1.0",
  "description": "Cross-platform launcher and local Docker companion for Möbius.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobius-os/mobius-desktop.git"
  },
  "scripts": {
    "start": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug --no-bundle",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --jobs 1",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:e2e": "playwright test",
    "renderer:dev": "vite --config vite.renderer.config.ts",
    "renderer:build": "vite build --config vite.renderer.config.ts",
    "icons": "node scripts/build-icons.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:configure": "node scripts/configure-release.mjs",
    "verify": "npm run version:check && npm run typecheck && npm test && npm run lint:rust && npm run format:rust && npm run renderer:build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.0",
    "png2icons": "^2.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
