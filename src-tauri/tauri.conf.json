{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Möbius Desktop",
  "version": "0.1.0",
  "identifier": "you.mobius.desktop",
  "build": {
    "beforeDevCommand": "npm run renderer:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run renderer:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "Möbius Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Möbius contributors",
    "shortDescription": "Your Möbius deployments, one click away",
    "longDescription": "Connect to hosted Möbius deployments or run a computer-bound local Möbius through Docker with explicit folder access.",
    "icon": [
      "../assets/icons/icon-192.png",
      "../assets/icons/icon.png",
      "../assets/icons/icon.ico",
      "../assets/icons/icon.icns"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
